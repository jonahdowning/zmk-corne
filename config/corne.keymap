#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <125>;
    quick-tap-ms = <175>;
};

&sk {
    quick-release;
    lazy;
};

/ {
    combos {
        compatible = "zmk,combos";

        Return {
            bindings = <&kp RETURN>;
            key-positions = <22 21 20>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <22 21 20 19>;
        };

        capsLock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <33 32 27 26>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <19 20 21>;
        };

        backTab {
            bindings = <&kp LS(TAB)>;
            key-positions = <18 19 20>;
        };

        mHomeRowApp {
            bindings = <&kp LC(LA(LS(LG(F))))>;
            key-positions = <38 16>;
            layers = <0 2 4 6 8 9>;
        };

        mDictation {
            bindings = <&kp LS(LG(LC(LA(V))))>;
            key-positions = <13 14 15>;
            layers = <0 2 4 6 8 9>;
        };

        mLeaderKey {
            bindings = <&kp LS(LA(LG(RIGHT)))>;
            key-positions = <39 20>;
            layers = <0 2 4 6 8 9>;
        };

        mMousless {
            bindings = <&kp LA(LC(LS(LG(RIGHT))))>;
            key-positions = <39 19>;
            layers = <0 2 4 6 8 9>;
        };

        l_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <14 15>;
        };

        r_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <20 21>;
        };

        toMacBASE {
            bindings = <&to 0>;
            key-positions = <3 0 5>;
        };

        toWindowBASE {
            bindings = <&to 1>;
            key-positions = <24 27 29>;
        };

        toSYS {
            bindings = <&to 10>;
            key-positions = <12 15 17>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <2 3 8 9>;
        };

        mDelWord {
            bindings = <&kp LA(BACKSPACE)>;
            key-positions = <37 40>;
            layers = <0 2 4 6 8 9>;
        };

        wDelWord {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <40 37>;
            layers = <1 3 5 7 8 9>;
        };

        stickyshift {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <19 20>;
        };

        mSwitchApps {
            bindings = <&kp LC(TAB)>;
            key-positions = <32 33>;
            layers = <0 2 4 6 8 9>;
        };

        mSwitchPrevrsApp {
            bindings = <&kp LC(LS(TAB))>;
            key-positions = <32 31>;
            layers = <0 2 4 6 8 9>;
        };

        wSwitchPrevApp {
            bindings = <&kp LS(LA(TAB))>;
            key-positions = <32 31>;
            layers = <0 2 4 6 8 9>;
        };

        wSwitchApp {
            bindings = <&kp LA(TAB)>;
            key-positions = <32 33>;
            layers = <0 2 4 6 8 9>;
        };

        altSitickyShift {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <16 15>;
        };

        oldStickyShift {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <38 39>;
        };
    };

    macros {
        wDelLine: del_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp END &kp LS(HOME) &kp BACKSPACE>;

            label = "DEL_LINE";
        };

        wbobb: mysterious {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp P &kp R &kp I &kp N &kp T &kp SEMI &kp S &kp T &kp A &kp R &kp R &kp Y &kp N0 &kp SEMI &kp C &kp H &kp E &kp E &kp R &kp RETURN>;

            label = "MYSTERIOUS";
        };

        mDelLine: mDelLine {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LC(RIGHT) &kp LC(BACKSPACE)>;

            label = "MDELLINE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MAC_BASE {
            bindings = <
&none                 &kp Q             &kp W           &kp E           &kp R               &kp T                             &kp Y                            &kp U                &kp I                &kp O                 &kp P                  &kp MINUS
&none                 &kp A             &kp S           &kp D           &kp F               &kp G                             &kp H                            &kp J                &kp K                &kp L                 &kp SEMI               &kp SQT
&kp LA(LS(LEFT_GUI))  &mt LEFT_SHIFT Z  &mt LEFT_GUI X  &mt LEFT_ALT C  &mt LEFT_CONTROL V  &mt LS(LA(LC(LG(LEFT_GUI)))) B    &mt LC(LA(LS(LG(RIGHT_GUI)))) N  &mt RIGHT_CONTROL M  &mt RIGHT_ALT COMMA  &mt RIGHT_GUI PERIOD  &mt RIGHT_SHIFT SLASH  &none
                                                        &lt 4 S         &lt 9 TAB           &lt 2 R                           &kp SPACE                        &lt 8 BSPC           &lt 6 B
            >;
        };

        WINDOW-BASE {
            bindings = <
&none  &kp Q             &kp W           &kp E           &kp R               &kp T                             &kp Y                            &kp U               &kp I                &kp O              &kp P                 &kp MINUS
&none  &kp A             &kp S           &kp D           &kp F               &kp G                             &kp H                            &kp J               &kp K                &kp L              &kp SEMI              &kp SQT
&none  &mt LEFT_SHIFT Z  &mt LEFT_GUI X  &mt LEFT_ALT C  &mt LEFT_CONTROL V  &mt LS(LA(LC(LG(LEFT_GUI)))) B    &mt RS(RA(RC(RG(RIGHT_GUI)))) N  &mt LEFT_CONTROL M  &mt RIGHT_ALT COMMA  &mt RIGHT_GUI DOT  &mt RIGHT_SHIFT FSLH  &none
                                         &lt 5 S         &lt 9 S             &lt 3 R                           &kp SPACE                        &lt 8 BSPC          &lt 7 B
            >;
        };

        mShort+Nav {
            bindings = <
&kp LS(LG(LC(LA(B))))         &kp LG(LC(LA(LS(GRAVE))))     &kp LC(LBKT)   &kp LC(RBKT)  &kp LC(R)         &kp LC(X)                           &kp LS(TAB)   &kp PG_DN  &kp PG_UP  &kp TAB        &kp ESC  &none
&kp LS(LA(LC(LG(NUMBER_4))))  &kp LG(LC(LA(LS(NUMBER_2))))  &kp LS(LC(Z))  &kp LC(Z)     &kp LC(C)         &kp LC(V)                           &kp LEFT      &kp DOWN   &kp UP     &kp RIGHT      &kp RET  &none
&kp LA(LS(LEFT_COMMAND))      &kp RSHFT                     &kp LEFT_GUI   &kp LALT      &kp LEFT_CONTROL  &kp LS(LA(LC(LG(LEFT_COMMAND))))    &kp LC(LEFT)  &mDelLine  &none      &kp LC(RIGHT)  &none    &none
                                                                           &none         &none             &none                               &kp SPACE     &kp BSPC   &kp DEL
            >;
        };

        wShort+Nav {
            bindings = <
&none                     &none          &kp LA(LBKT)   &kp LA(RBKT)  &kp LC(R)         &kp LC(X)                           &kp LS(TAB)  &kp PG_DN  &kp PG_UP  &kp TAB    &kp ESC  &none
&none                     &kp LG(LS(S))  &kp LS(LC(Z))  &kp LC(Z)     &kp LC(C)         &kp LC(V)                           &kp LEFT     &kp DOWN   &kp UP     &kp RIGHT  &kp RET  &none
&kp LA(LS(LEFT_COMMAND))  &kp RSHFT      &kp LEFT_GUI   &kp LALT      &kp LEFT_CONTROL  &kp LS(LA(LC(LG(LEFT_COMMAND))))    &kp HOME     &wDelLine  &none      &kp END    &none    &none
                                                        &wbobb        &none             &none                               &kp SPACE    &kp BSPC   &kp DEL
            >;
        };

        mMouse+Window {
            bindings = <
&none  &none           &mmv MOVE_RIGHT  &mmv MOVE_UP     &mkp RCLK  &none    &kp LA(LS(LG(GRAVE)))       &kp N1                 &kp N2                 &kp N3         &kp N4    &kp LS(LA(LG(P)))
&none  &msc SCRL_UP    &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mkp LCLK  &none    &kp H                       &kp J                  &kp K                  &kp L          &kp SEMI  &kp SQT
&none  &msc SCRL_DOWN  &msc SCRL_LEFT   &msc SCRL_RIGHT  &mkp MCLK  &none    &kp LS(LA(LG(F)))           &kp LS(LA(LG(MINUS)))  &kp LG(LA(LS(EQUAL)))  &kp LC(LG(F))  &none     &kp LA(LS(LG(R)))
                                        &none            &none      &none    &kp LA(LG(LS(LEFT_SHIFT)))  &kp LA(LC(LEFT_GUI))   &none
            >;
        };

        wMouse+Window {
            bindings = <
&none      &none           &mmv MOVE_RIGHT  &mmv MOVE_UP     &mkp RCLK  &none    &kp LA(F4)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp N4    &kp LS(LA(LG(P)))
&none      &msc SCRL_UP    &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mkp LCLK  &none    &none       &kp LG(N4)  &kp LG(N5)  &kp LG(N6)  &kp SEMI  &kp SQT
&kp LG(Z)  &msc SCRL_DOWN  &msc SCRL_LEFT   &msc SCRL_RIGHT  &mkp MCLK  &none    &none       &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &none     &none
                                            &none            &none      &none    &kp N0      &none       &none
            >;
        };

        mVS+FN {
            bindings = <
&none  &none      &none     &none     &none      &none    &none  &kp F7  &kp F8  &kp F9  &kp F10  &none
&none  &none      &none     &none     &none      &none    &none  &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &kp LSHFT  &kp LGUI  &kp LALT  &kp LCTRL  &none    &none  &kp F1  &kp F2  &kp F3  &kp F12  &none
                            &none     &none      &none    &none  &none   &none
            >;
        };

        wVS+FN {
            bindings = <
&none  &none      &none     &none        &none           &none    &none  &kp F7  &kp F8  &kp F9  &kp F10  &none
&none  &none      &none     &kp LA(F10)  &kp LS(LC(F5))  &none    &none  &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &kp LSHFT  &kp LGUI  &kp LALT     &kp LCTRL       &none    &none  &kp F1  &kp F2  &kp F3  &kp F12  &none
                            &none        &none           &none    &none  &none   &none
            >;
        };

        Sym+delim {
            bindings = <
&none  &none  &none  &none  &none  &none    &kp GRAVE         &kp PERCENT            &kp EXCLAMATION  &kp TILDE          &kp PIPE       &none
&none  &none  &none  &none  &none  &none    &kp LESS_THAN     &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &kp LEFT_BRACKET   &kp AMPERSAND  &kp DOLLAR
&none  &none  &none  &none  &none  &none    &kp GREATER_THAN  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp AT_SIGN    &none
                     &none  &none  &none    &none             &none                  &none
            >;
        };

        Media+Num {
            bindings = <
&none                 &none      &kp K_MUTE  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_INC                          &kp FSLH      &kp N7    &kp N8  &kp N9  &kp MINUS  &none
&none                 &none      &kp C_PREV  &kp C_PLAY    &kp C_NEXT       &kp C_BRIGHTNESS_DEC                          &kp DOT       &kp N4    &kp N5  &kp N6  &kp EQUAL  &none
&kp LS(LA(LEFT_GUI))  &kp LSHFT  &kp LGUI    &kp LALT      &kp LCTRL        &mt LC(LA(LS(LEFT_GUI))) C_BRIGHTNESS_AUTO    &kp ASTERISK  &kp N1    &kp N2  &kp N3  &kp PLUS   &none
                                             &none         &none            &none                                         &kp N0        &kp BSPC  &none
            >;
        };

        SYSTEM {
            bindings = <
&bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none  &none  &none  &none  &none
&out OUT_USB  &out OUT_BLE  &none         &none         &none         &none           &none  &none  &none  &none  &none  &none
&none         &none         &none         &none         &none         &none           &none  &none  &none  &none  &none  &none
                                          &none         &none         &none           &none  &none  &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
